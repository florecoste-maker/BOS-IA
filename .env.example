# --- Jamaliance / BOS-IA ---
# Copiez vers .env.local (dev) ou renseignez-les dans hPanel Hostinger (prod).
# Vitrine publique = jamaliance.com (Horizons) — ne pas la remplacer.
# Moteur BOS-IA = bos.jamaliance.com (Web App Node.js).

# URL publique du site agence (Hostinger Horizons)
NEXT_PUBLIC_JAMALIANCE_SITE_URL=https://jamaliance.com

# URL du moteur BOS-IA (sous-domaine prévu)
NEXT_PUBLIC_APP_URL=https://bos.jamaliance.com

# --- TidyCal (prise de rendez-vous) ---
# Même calendrier que jamaliance.com/reservation
NEXT_PUBLIC_TIDYCAL_URL=https://tidycal.com/m4g6pv9/jamaliance
# Ou uniquement le chemin vanity (sans domaine)
NEXT_PUBLIC_TIDYCAL_VANITY_PATH=
# Optionnel : URL d'embed (sinon dérivée de NEXT_PUBLIC_TIDYCAL_URL?embed=1)
NEXT_PUBLIC_TIDYCAL_EMBED_URL=

# Jeton personnel : TidyCal → Integrations → Advanced → Personal tokens
# (plan Individual / Pro / Agency requis pour l'API)
TIDYCAL_API_TOKEN=

# ID du type de rendez-vous utilisé pour créer des créneaux via POST /api/integrations/tidycal
TIDYCAL_BOOKING_TYPE_ID=
