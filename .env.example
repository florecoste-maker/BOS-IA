# --- Jamaliance / BOS-IA ---
# URLs et TidyCal optionnels : sans elles, les valeurs Jamaliance ci-dessous s'appliquent.
# Seuls BOS_ADMIN_PASSWORD et BOS_SESSION_SECRET sont obligatoires (accès au cockpit).
# Sans base de données, le cockpit fonctionne en mode démonstration (données fictives).
# Copiez vers .env.local (dev) ou renseignez-les dans hPanel Hostinger (prod).
# Vitrine publique = jamaliance.com (Horizons) — ne pas la remplacer.
# Moteur BOS-IA = app.jamaliance.com (Web App Node.js).

# URL publique du site agence (Hostinger Horizons)
NEXT_PUBLIC_JAMALIANCE_SITE_URL=https://jamaliance.com

# URL du moteur BOS-IA (sous-domaine prévu)
NEXT_PUBLIC_APP_URL=https://app.jamaliance.com

# --- TidyCal (prise de rendez-vous) ---
# Même calendrier que jamaliance.com/reservation
NEXT_PUBLIC_TIDYCAL_URL=https://tidycal.com/m4g6pv9/jamaliance
# Ou uniquement le chemin vanity (sans domaine)
NEXT_PUBLIC_TIDYCAL_VANITY_PATH=
# Optionnel : URL d'embed (sinon dérivée de NEXT_PUBLIC_TIDYCAL_URL?embed=1)
NEXT_PUBLIC_TIDYCAL_EMBED_URL=

# Jeton personnel : TidyCal → Integrations → Advanced → Personal tokens
# (plan Individual / Pro / Agency requis pour l'API)
TIDYCAL_API_TOKEN=

# ID du type de rendez-vous utilisé pour créer des créneaux via POST /api/integrations/tidycal
TIDYCAL_BOOKING_TYPE_ID=

# --- Accès au cockpit (obligatoire) ---
# Sans ces deux valeurs, /app et /api restent fermés (fail-closed).
# Mot de passe administrateur : 12 caractères minimum.
BOS_ADMIN_PASSWORD=
# Secret de signature des sessions : 32 caractères minimum, aléatoire.
# Générer avec : openssl rand -hex 32
BOS_SESSION_SECRET=

# --- Agents IA (Claude) ---
# Clé API : console.anthropic.com → API Keys. Sans elle, les agents restent en lecture seule.
ANTHROPIC_API_KEY=
# Optionnel : modèle utilisé par les agents (défaut : claude-opus-5-5)
BOS_AGENTS_MODEL=

# --- Base de données (MySQL / MariaDB Hostinger) ---
# hPanel → Bases de données → Gestion : créer la base et son utilisateur.
# Sans ces valeurs : mode démonstration (données fictives en mémoire).
# Les tables (préfixe bos_) sont créées automatiquement au premier démarrage.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Ou bien une seule URL (prioritaire) : mysql://utilisateur:motdepasse@hote:3306/base
DATABASE_URL=

# --- Agents planifiés ---
# Secret du planificateur (32 caractères minimum) : openssl rand -hex 32
# Même valeur dans hPanel ET dans le secret de dépôt GitHub BOS_CRON_SECRET.
# Requiert aussi la base MySQL et ANTHROPIC_API_KEY.
BOS_CRON_SECRET=
# Optionnel : agents planifiés (identifiants séparés par des virgules ; vide = tous)
BOS_AGENTS_PLANIFIES=
# Optionnel : intervalle minimal entre deux analyses d'un même agent (défaut : 20)
BOS_AGENTS_INTERVALLE_HEURES=

# --- E-mails des actions approuvées (SMTP) ---
# Sans SMTP_HOST / SMTP_FROM : les e-mails approuvés restent « à envoyer » à la main.
# Google Workspace : smtp.gmail.com, port 587, utilisateur = adresse complète,
#   mot de passe = mot de passe d'application (compte Google → Sécurité).
# Messagerie Hostinger : smtp.hostinger.com, port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur affiché, ex. Jamaliance <contact@jamaliance.com>
SMTP_FROM=
# Mode test conseillé au début : TOUS les envois partent vers cette adresse.
BOS_EMAIL_REDIRECTION=
# Optionnel : copie cachée de chaque envoi (archive)
BOS_EMAIL_COPIE=

# --- Alertes et sauvegardes ---
# Adresse qui reçoit : rapport après chaque passage planifié (échecs, validations
# en attente), alerte si un e-mail approuvé ne part pas, sauvegarde hebdomadaire.
# Utilise le SMTP ci-dessus ; sans adresse, rien n'est envoyé.
BOS_ALERTES_EMAIL=
